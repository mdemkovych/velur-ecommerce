# Copy to `.env.local` and fill in. Never commit the filled file.
# No variable here may be prefixed with NEXT_PUBLIC_ (tech spec §1).

# ── Database (Supabase / Postgres) ────────────────────────────────────────────

# Pooled connection used by the running app — Supabase "Transaction" pooler,
# port 6543. Append ?pgbouncer=true.
DATABASE_URL=

# Direct connection, port 5432. Used only by `prisma migrate`: the pooler runs
# in transaction mode and cannot hold the locks the migration engine needs.
DIRECT_URL=

# ── Supabase Auth ─────────────────────────────────────────────────────────────

# Project URL and the anon (publishable) key. Despite the usual Supabase
# examples, these stay SERVER-side: the login form posts to /api/auth/login and
# the sign-in happens on the server, so no NEXT_PUBLIC_ variable is needed and
# the §1 convention holds.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key. Bypasses RLS — used only by the one-off script that creates
# the first OWNER account. Never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Required ──────────────────────────────────────────────────────────────────

# Public origin of the deployment. Used to build the Monobank redirect and
# webhook URLs and to resolve Open Graph image paths.
# Required in production; falls back to the request origin in development.
APP_URL=http://localhost:3000

# Signs the short-lived payment token (min. 32 random chars): the proof that
# whoever asks for a payment page is the person who just placed that order, and
# therefore cannot spend another buyer's attempts (src/lib/paymentToken.ts).
# It guards no session and no password, Supabase Auth owning those.
# Generate with: openssl rand -base64 48
# Required in production; development uses a per-process ephemeral secret.
PAYMENT_TOKEN_SECRET=

# Shared secret for the scheduled job that releases stock from unpaid orders.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Set to `1` on a pre-launch deployment. `robots.txt` then disallows everything
# and every response carries `X-Robots-Tag: noindex, nofollow`, so the demo on
# `*.vercel.app` — real catalogue, real prices, unfinished checkout — stays out
# of search results. Read at BUILD time (robots.txt is prerendered), so it must
# be set on the deployment before it builds. Leave unset for the real shop.
DEMO_NOINDEX=

# ── Integrations (the app degrades gracefully without these) ──────────────────

# Nova Poshta API key. Without it, city/branch autocomplete and the delivery
# estimate are disabled and the checkout falls back to manual address entry.
NOVA_POSHTA_API_KEY=


# Monobank Acquiring merchant token. Without it, online payment is hidden in the
# checkout and the webhook rejects every callback.
MONOBANK_API_TOKEN=

# Upstash Redis, for rate limiting shared across serverless instances.
# Without it, limits fall back to a per-process in-memory counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry, for unhandled server exceptions. Server-side only — the browser SDK
# would be blocked by our own CSP. Started only when this parses as a URL, and
# never in development, so a local mistake does not spend the live quota.
SENTRY_DSN=

# Resend, for the one letter the shop sends: the order-paid confirmation.
# Without either variable no letter is sent and nothing else changes.
RESEND_API_KEY=

# The sender, and the reason moving to the real domain touches no code. Resend
# only sends from a domain whose DNS proves it is yours, so until
# velur.example exists this stays "VELUR <onboarding@resend.dev>", which
# reaches the Resend account's own address and nobody else.
MAIL_FROM=

# Telegram, for telling the owner a paid order arrived. The panel is where
# orders are worked; this is what makes somebody open it. Needs no domain, so
# unlike the customer's letter it works before velur.example exists.
# @BotFather → /newbot gives the token. The chat id appears only after somebody
# writes to the bot — a bot cannot start a conversation — so read it from
# https://api.telegram.org/bot<token>/getUpdates once you have. Without both, no
# notice is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TurboSMS, for the customer's payment confirmation. The token comes from the
# cabinet; the sender is the alpha-name registered there, which is what the
# telephone shows instead of a number and is capped at 11 characters. It goes
# through moderation, so the account can hold a token that sends nothing until
# the name is approved. The cabinet also switches off an HTTP API connection left
# six months unused, which here means six months without a paid order. Do not set
# an IP restriction beside it: Vercel functions have no fixed address. Without
# both variables, no SMS is sent and nothing else changes.
TURBOSMS_API_TOKEN=
TURBOSMS_SENDER=VELUR
